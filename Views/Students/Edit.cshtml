@model Student
@{
    ViewData["Title"] = "Sửa sinh viên";
}
<h1>Sửa sinh viên</h1>
<div class="form-card">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="validation"></span>
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" />
        <span asp-validation-for="Age" class="validation"></span>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="validation"></span>
        <label asp-for="Major"></label>
        <input asp-for="Major" />
        <span asp-validation-for="Major" class="validation"></span>
        <div class="form-actions">
            <button class="btn primary" type="submit">Lưu thay đổi</button>
            <a class="btn" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>
